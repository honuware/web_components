{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "honuware-ui": {
      "projectType": "library",
      "root": "projects/honuware-ui",
      "sourceRoot": "projects/honuware-ui",
      "prefix": "hw",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/honuware-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/honuware-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": ["zone.js", "zone.js/testing"],
            "tsConfig": "projects/honuware-ui/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "karmaConfig": "projects/honuware-ui/karma.conf.js",
            "styles": [],
            "scripts": []
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/honuware-ui/**/*.ts",
              "projects/honuware-ui/**/*.html"
            ]
          }
        }
      }
    }
  }
}
